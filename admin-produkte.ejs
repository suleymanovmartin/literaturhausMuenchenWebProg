<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Adminbereich</title>
  <style>
    body {
      background-color: #E8DCC4; /* Sandiges Gelb als ruhiger Hintergrund */
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: #333;
      margin: 0;
      padding: 20px;
    }

    /* Überschriften zentrieren und in Primärfarbe */
    h1, h2 {
      text-align: center;
      color: #8B1E3F; 
      margin-top: 30px;
    }

    /* Tabellen-Container für zentrierte, breite Listen */
    .scroll-container {
      max-height: 450px; 
      overflow-y: auto;  
      width: 95%; /* Breite Verteilung */
      margin: 0 auto 40px auto; /* Zentriert den Container */
      background-color: white;
      border-radius: 8px; /* Leicht abgerundete Ecken */
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    /* Tabellenkopf in Bordeauxrot */
    th {
      background-color: #8B1E3F;
      color: #E8DCC4;
      padding: 12px;
      text-align: left;
      position: sticky; /* Hält den Kopf beim Scrollen oben */
      top: 0;
    }

    /* Mehr Platz zwischen den Büchern */
    td {
      padding: 15px 10px;
      border-bottom: 1px solid #ccc;
      vertical-align: middle;
    }

    /* Mini-Bildflächen für die Cover */
    .mini-cover {
      width: 45px;
      height: 65px;
      object-fit: cover; /* Verhindert, dass Bilder verzerrt werden */
      border: 1px solid #2F4F4F; /* Detailfarbe Grün als Rahmen */
      border-radius: 4px;
    }

    /* Kurzbeschreibung: Breiter Platz und ... bei zu viel Text */
    .kurzbeschreibung {
      max-width: 250px; /* Gibt der Spalte mehr Platz */
      white-space: nowrap; /* Verhindert Zeilenumbrüche */
      overflow: hidden; /* Versteckt alles, was über den Rand ragt */
      text-overflow: ellipsis; /* Erzeugt die "..." */
    }

    /* Buttons in Detailfarbe Grün */
    button {
      background-color: #2F4F4F;
      color: white;
      border: none;
      padding: 8px 12px;
      cursor: pointer;
      border-radius: 4px;
      font-weight: bold;
    }

    button:hover {
      background-color: #1a2c2c;
    }

    /* --- Formular Styling (Die Gruppierungen) --- */
    .admin-form {
      max-width: 800px;
      margin: 0 auto;
      background-color: white;
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      border-top: 5px solid #8B1E3F;
    }

    .form-group {
      display: grid;
      grid-template-columns: 1fr 1fr; /* Zwei Spalten nebeneinander */
      gap: 15px;
      margin-bottom: 20px;
      padding-bottom: 20px;
      border-bottom: 2px solid #E8DCC4;
    }

    /* Bestimmte Blöcke brauchen die volle Breite */
    .form-group.full-width {
      grid-template-columns: 1fr; /* Nur eine Spalte */
    }

    .admin-form label {
      display: block;
      font-weight: bold;
      color: #8B1E3F;
      margin-bottom: 5px;
    }

    .admin-form input, .admin-form textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 4px;
      box-sizing: border-box; /* Verhindert, dass Padding das Feld breiter macht */
    }

    /* Mehr Platz für den Text der Kurzbeschreibung */
    .admin-form textarea {
      min-height: 100px;
      resize: vertical;
    }
  </style>
</head>
<body>
  <h1>Verwaltungsinterface</h1>
  <a href="/">Zurück zur Startseite</a>
  <div class="scroll-container">
    <table>
      <tr>                       
        <th>Titel</th>           
        <th>ISBN</th>
        <th>Autor</th>
        <th>Genre</th>
        <th>Frontcover</th>
        <th>Kurzbeschreibung</th>
        <th>Preis</th>
        <th>Bestand</th>
        <th>ID</th>
        <th>Aktionen</th>
      </tr>
      <%# Die Route übergibt das aktuelle bucharray unter dem verständlichen Namen buecher. %>
      <% buecher.forEach(function(buch) { %>
        <tr>
          <td><%= buch.title %></td>
          <td><%= buch.isbn %></td>
          <td><%= buch.author %></td>
          <td><%= buch.genre %></td>
          <td><img src="<%= buch.frontcover %>" class="mini-cover" alt="Front"></td>
          <td class="kurzbeschreibung"><%= buch.description %></td>
          <td><%= buch.price %></td>
          <td>
            <%# Die Buch-ID im Pfad sagt der Route, welcher Bestand geändert werden soll. %>
            <form action="/admin/produkte/bestand/<%= buch.id %>" method="POST">
              <input type="number" name="bestand" value="<%= buch.bestand %>" required>
              <button type="submit">Speichern</button>
            </form>
          </td>
          <td><%= buch.id %></td>
          <td>
            <form action="/admin/produkte/loeschen/<%= buch.id %>" method="POST">
              <button type="submit">Löschen</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  </div>

  <form action="/admin/produkte/hinzufuegen" method="POST" class="admin-form">
  
    <div class="form-group">
      <div>
        <label for="add-title">Titel</label>
        <input type="text" id="add-title" name="title" required>
      </div>
      <div>
        <label for="add-isbn">ISBN</label>
        <input type="text" id="add-isbn" name="isbn" required>
      </div>
      <div>
        <label for="add-author">Autor</label>
        <input type="text" id="add-author" name="author" required>
      </div>
      <div>
        <label for="add-genre">Genre</label>
        <input type="text" id="add-genre" name="genre" required>
      </div>
    </div>
  
    <div class="form-group full-width">
      <div>
        <label for="add-frontcover">Frontcover (URL)</label>
        <input type="text" id="add-frontcover" name="frontcover" required>
      </div>
    </div>
  
    <div class="form-group full-width">
      <div>
        <label for="add-description">Kurzbeschreibung</label>
        <textarea id="add-description" name="description" required></textarea>
      </div>
    </div>
  
    <div class="form-group">
      <div>
        <label for="add-price">Preis</label>
        <input type="number" id="add-price" name="price" step="0.01" min="0.01" required>
      </div>
      <div>
        <label for="add-bestand">Bestand</label>
        <input type="number" id="add-bestand" name="bestand" required>
      </div>
    </div>
  
    <button type="submit" style="width: 100%; padding: 12px; font-size: 16px;">Neues Buch hinzufügen</button>
  </form>

  <hr style="margin: 40px 0;"> <h2>Reservierungen verwalten</h2>
  
  <div class="scroll-container">
    <table>
      <tr>
        <th>ID</th>                       
        <th>Kunde</th>           
        <th>Reserviertes Buch</th>
        <th>Aktionen</th>
      </tr>
      <% reservierungarray.forEach(function(reservierung) { %>
        <tr>
          <td><%= reservierung.id %></td> 
          <td><%= reservierung.name %></td>
          <td><%= reservierung.title %></td> 
          <td>
            <%# Beide Adminaktionen senden die feste Reservierungs-ID, nicht die Arrayposition. %>
            <form action="/admin/produkte/reservierung/loeschen/<%= reservierung.id %>" method="POST" style="display:inline-block;">
              <button type="submit">Storniert (+1 Bestand)</button>
            </form>
  
            <form action="/admin/produkte/reservierung/bestaetigen/<%= reservierung.id %>" method="POST" style="display:inline-block;">
              <button type="submit">Abgeholt</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  </div>
</body>
</html>
