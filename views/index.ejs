<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

  <header class="kopfbereich">

    <div class="header-zeile">
      <a class="navbar" href="/">
        <img src="/images/logo/literaturhaus-muenchen-logo.png" class="logo" alt="Literaturhaus München Logo">
      </a>

      <div class="buttonbereich">
      <div class="desktop-menue">


<button type="button" class="nav-link" onclick="window.location.href='/'">
  Start
</button>

<button type="button" class="nav-link" onclick="window.location.href='/secondhand'">
  Second-Hand
</button>

<button type="button" class="nav-link" onclick="window.location.href='/reservieren'">
  Reservierung
</button>

<button type="button" class="nav-link" onclick="window.location.href='/admin/produkte'">
  Admin
</button>

<button type="button" class="nav-link" onclick="window.location.href='/login'">
  Log In
</button>

      </div>
      </div>

      <div class="burger-menue">
      <button type="button" class="burgerbutton" onclick="menueUmschalten()">
        ☰
      </button>

        <div class="burger-liste" id="burgerListe">
        <button type="button" onclick="window.location.href='/'">Start</button>
        <button type="button" onclick="window.location.href='/secondhand'">Second-Hand</button>
        <button type="button" onclick="window.location.href='/reservieren'">Reservierung</button>
        <button type="button" onclick="window.location.href='/admin/produkte'">Admin</button>
        <button type="button" onclick="window.location.href='/login'">Log-In</button>
      </div>

    </div>

    </div>
  </header>

  <script>
  function menueUmschalten() {
    document.getElementById("burgerListe").classList.toggle("anzeigen");
  }
</script>

  <header class="startbild">
    <div class="startbildoverlay">
      <div class="container">
        <div class="row align-items-center min-vh-75">
          <div class="col-lg-7">
            <p class="text1">Online stöbern · Lokal reservieren · Vor Ort abholen</p>
            <p class="text2">Literaturhaus München</p>
            <p class="text3">
              Entdecken Sie neue Bücher, stöbern Sie durch ausgewählte Titel und reservieren Sie Ihre Favoriten unkompliziert für eine Woche in unserer Münchner Filiale.
            </p>

          </div>
        </div>
      </div>
    </div>
  </header>

  <main>
    <section class="section">
      <div class="container">
        <div class="row align-items-end mb-4">
          <div class="col-md-8">
            <p class="sectiontext">Highlights der Woche</p>
          </div>
        </div>

        <div class="row">
          <% neuesteBuecher.forEach(function(buch) { %>
            <div class="col-lg-6 mb-4">
              <article class="bookcard h-100">
                <div class="row g-0 h-100 align-items-center">
                  <div class="col-md-5">
                    <div class="bookimage">
                      <img src="<%= buch.frontcover %>" class="bookpic" alt="Cover von <%= buch.title %>">
                    </div>
                  </div>

                  <div class="col-md-7">
                    <div class="bookcontent">
                      <span class="badge"><%= buch.genre %></span>
                      <h1><%= buch.title %></h1>
                      <p class="author">von <%= buch.author %></p>
                      <p class="bookstory"><%= buch.description %></p>

                      <ul class="bookinfos">
                        <li><strong>ISBN:</strong> <%= buch.isbn %></li>
                        <li><strong>Preis:</strong> <%= Number(buch.price).toFixed(2) %> €</li>
                        <li><strong>Lagerbestand:</strong> <%= buch.bestand %></li>
                      </ul>

                      <a href="/reservieren?buch=<%= buch.id %>" class="btn reservierenbutton">Jetzt reservieren</a>
                    </div>
                  </div>
                </div>
              </article>
            </div>
          <% }); %>
        </div>
      </div>
    </section>

    <section class="section aboutsection">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6 mb-4 mb-lg-0">
            <img src="/images/sections/about-literaturhaus-muenchen.png" class="aboutimage" alt="Innenansicht des Literaturhaus München">
          </div>

          
            <div class="abouttext">
            <p class="text4"> Ihre Buchhandlung im Herzen Münchens</p>
            <p class="text5">
              Das Literaturhaus München verbindet persönliche Beratung mit einer übersichtlichen Online-Präsentation des Sortiments. Kundinnen und Kunden können Bücher entdecken, Informationen ansehen und Titel bequem reservieren.
            </p>
            <p class="text5">
              Unser besonderer Vorteil: kein komplizierter Kaufprozess, keine Zahlungsdaten und keine unnötigen Angaben. Bücher werden eine Woche zurückgelegt und können in der Filiale abgeholt werden.
            </p>
            </div>

            <div class="contactbox">
              <p><strong>Kontakt:</strong> kontakt@literaturhaus-muenchen.de</p>
              <p><strong>Telefon:</strong> 089 / 123456</p>
              <p><strong>Filiale:</strong> Literaturhaus München</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <footer id="footer" class="footer">
    <div class="container">
      <div class="row gy-4 align-items-start">
        <div class="col-lg-4 col-md-6">
          <h2 class="lh-footer-brand">Literaturhaus München</h2>
          <p class="lh-footer-text">
            Ihre Buchhandlung im Herzen Münchens: online stöbern, lokal reservieren und persönlich abholen.
          </p>
          <a href="/reservieren" class="btn btn-lh-footer">Buch reservieren</a>
        </div>

        <div class="col-lg-3 col-md-6">
          <h3>Kontakt</h3>
          <p class="mb-2">Literaturhaus München</p>
          <p class="mb-2">Salvatorplatz 1</p>
          <p class="mb-2">80333 München</p>
          <p class="mb-2"><a href="mailto:kontakt@literaturhaus-muenchen.de">kontakt@literaturhaus-muenchen.de</a></p>
          <p class="mb-0">089 / 123456</p>
        </div>

        <div class="col-lg-3 col-md-6">
          <h3>Reservierung</h3>
          <p class="lh-footer-text mb-2">
            Reservierte Bücher werden eine Woche für Sie zurückgelegt.
          </p>
          <p class="mb-2"><strong>Abholung:</strong> in unserer Filiale</p>
          <p class="mb-0"><strong>Onlinekauf:</strong> nicht erforderlich</p>
        </div>

        <div class="col-lg-2 col-md-6">
          <h3>Links</h3>
          <ul class="lh-footer-links">
            <li><a href="/">Startseite</a></li>
            <li><a href="#neuerscheinungen">Neuerscheinungen</a></li>
            <li><a href="/reservieren">Reservierung</a></li>
            <li><a href="/login">Login</a></li>
            <li><a href="/impressum">Impressum</a></li>
            <li><a href="/datenschutz">Datenschutz</a></li>
          </ul>
        </div>
      </div>

      <div class="footer">
        <p class="mb-0">Beratung · Reservierung · Abholung</p>
      </div>
    </div>
  </footer>

</body>
</html>
